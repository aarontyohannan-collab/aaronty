# ==============================================================================
# AARON TY PORTFOLIO — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local to activate real-time features locally:
# cp .env.example .env.local
#
# On Vercel: Add these variables in Project Settings -> Environment Variables.
# ==============================================================================

# Resend API Key for live contact form transmission (https://resend.com)
# When left empty, the portfolio operates in development/demo mode,
# printing received inquiries directly to the server log and displaying 
# an instant confirmation banner to the visitor.
RESEND_API_KEY=re_your_api_key_here

# Target recipient email for contact messages
CONTACT_RECIPIENT_EMAIL=aaronty@gmail.com

# Public site URL (for canonical SEO and OpenGraph previews)
NEXT_PUBLIC_SITE_URL=https://aaronty.vercel.app
